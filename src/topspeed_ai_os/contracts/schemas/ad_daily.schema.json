{
  "$id": "https://topspeed.local/contracts/v1/ad_daily.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ad_group_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "ad_orders": {
      "type": "integer"
    },
    "ad_revenue": {
      "format": "canonical-decimal",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-logical-type": "DECIMAL"
    },
    "ad_spend": {
      "format": "canonical-decimal",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-logical-type": "DECIMAL"
    },
    "ad_units": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "campaign_id": {
      "minLength": 1,
      "type": "string"
    },
    "campaign_name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "channel": {
      "minLength": 1,
      "type": "string"
    },
    "clicks": {
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string",
      "x-timezone-required": true
    },
    "ctr": {
      "anyOf": [
        {
          "format": "canonical-decimal",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string",
          "x-decimal-range": {
            "maximum": "1",
            "minimum": "0"
          },
          "x-logical-type": "DECIMAL"
        },
        {
          "type": "null"
        }
      ]
    },
    "cvr": {
      "anyOf": [
        {
          "format": "canonical-decimal",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string",
          "x-decimal-range": {
            "maximum": "1",
            "minimum": "0"
          },
          "x-logical-type": "DECIMAL"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_as_of": {
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string",
      "x-timezone-required": true
    },
    "impressions": {
      "type": "integer"
    },
    "roas": {
      "anyOf": [
        {
          "format": "canonical-decimal",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string",
          "x-logical-type": "DECIMAL"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "sku": {
      "minLength": 1,
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "source_file_hash": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stat_date": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "ad_orders",
    "ad_revenue",
    "ad_spend",
    "campaign_id",
    "channel",
    "clicks",
    "created_at",
    "data_as_of",
    "impressions",
    "run_id",
    "sku",
    "source",
    "stat_date"
  ],
  "title": "AD_DAILY",
  "type": "object"
}
