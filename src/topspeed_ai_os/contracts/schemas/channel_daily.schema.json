{
  "$id": "https://topspeed.local/contracts/v1/channel_daily.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "channel": {
      "minLength": 1,
      "type": "string"
    },
    "channel_fees": {
      "anyOf": [
        {
          "format": "canonical-decimal",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string",
          "x-logical-type": "DECIMAL"
        },
        {
          "type": "null"
        }
      ]
    },
    "channel_product_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "conversion_rate": {
      "anyOf": [
        {
          "format": "canonical-decimal",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string",
          "x-decimal-range": {
            "maximum": "1",
            "minimum": "0"
          },
          "x-logical-type": "DECIMAL"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string",
      "x-timezone-required": true
    },
    "data_as_of": {
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string",
      "x-timezone-required": true
    },
    "gross_sales": {
      "format": "canonical-decimal",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-logical-type": "DECIMAL"
    },
    "net_sales": {
      "format": "canonical-decimal",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-logical-type": "DECIMAL"
    },
    "orders": {
      "type": "integer"
    },
    "page_views": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "refund_amount": {
      "format": "canonical-decimal",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-logical-type": "DECIMAL"
    },
    "refunds": {
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "settlement_amount": {
      "anyOf": [
        {
          "format": "canonical-decimal",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string",
          "x-logical-type": "DECIMAL"
        },
        {
          "type": "null"
        }
      ]
    },
    "sku": {
      "minLength": 1,
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "stat_date": {
      "format": "date",
      "type": "string"
    },
    "units_sold": {
      "type": "integer"
    }
  },
  "required": [
    "channel",
    "created_at",
    "data_as_of",
    "gross_sales",
    "net_sales",
    "orders",
    "refund_amount",
    "refunds",
    "run_id",
    "sku",
    "source",
    "stat_date",
    "units_sold"
  ],
  "title": "CHANNEL_DAILY",
  "type": "object"
}
