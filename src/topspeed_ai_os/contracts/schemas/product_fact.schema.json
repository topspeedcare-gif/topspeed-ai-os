{
  "$id": "https://topspeed.local/contracts/v1/product_fact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string",
      "x-timezone-required": true
    },
    "data_as_of": {
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string",
      "x-timezone-required": true
    },
    "fact_id": {
      "minLength": 1,
      "pattern": "^fact_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "fact_type": {
      "minLength": 1,
      "type": "string"
    },
    "fact_value": {
      "type": [
        "object",
        "array"
      ]
    },
    "run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sku": {
      "minLength": 1,
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "source_checksum": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_uri": {
      "anyOf": [
        {
          "format": "uri",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^task_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification_status": {
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "REJECTED",
        "EXPIRED"
      ],
      "type": "string"
    },
    "verified_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string",
          "x-timezone-required": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "created_at",
    "data_as_of",
    "fact_id",
    "fact_type",
    "fact_value",
    "sku",
    "source",
    "verification_status"
  ],
  "title": "PRODUCT_FACT",
  "type": "object"
}
