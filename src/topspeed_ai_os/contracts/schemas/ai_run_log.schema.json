{
  "$id": "https://topspeed.local/contracts/v1/ai_run_log.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after_value": {
      "anyOf": [
        {
          "type": [
            "object",
            "array"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "agent": {
      "minLength": 1,
      "type": "string"
    },
    "approval_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^apr_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_status": {
      "anyOf": [
        {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED",
            "EXPIRED",
            "CANCELLED",
            "EXECUTED",
            "FAILED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "audit_status": {
      "anyOf": [
        {
          "enum": [
            "PASS",
            "WARN",
            "FAIL"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "before_value": {
      "anyOf": [
        {
          "type": [
            "object",
            "array"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string",
      "x-timezone-required": true
    },
    "data_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string",
          "x-timezone-required": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_seq": {
      "type": "integer"
    },
    "event_type": {
      "minLength": 1,
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string",
          "x-timezone-required": true
        },
        {
          "type": "null"
        }
      ]
    },
    "human_edit_ratio": {
      "anyOf": [
        {
          "format": "canonical-decimal",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string",
          "x-decimal-range": {
            "maximum": "1",
            "minimum": "0"
          },
          "x-logical-type": "DECIMAL"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^idem_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_summary": {
      "minLength": 1,
      "type": "string"
    },
    "log_id": {
      "minLength": 1,
      "pattern": "^log_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "output_summary": {
      "minLength": 1,
      "type": "string"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "enum": [
        "STARTED",
        "SUCCEEDED",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ],
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "skill": {
      "anyOf": [
        {
          "enum": [
            "sourcing",
            "launch",
            "ads_ops",
            "content",
            "inventory",
            "data"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sku": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": [
        "object",
        "array"
      ]
    },
    "started_at": {
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string",
      "x-timezone-required": true
    },
    "task_id": {
      "minLength": 1,
      "pattern": "^task_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "tool_name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "agent",
    "created_at",
    "event_seq",
    "event_type",
    "input_summary",
    "log_id",
    "output_summary",
    "result",
    "run_id",
    "source",
    "started_at",
    "task_id"
  ],
  "title": "AI_RUN_LOG",
  "type": "object"
}
